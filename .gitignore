__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# Run output. Regenerated from configs/ plus the raw extract; copied into
# mLOS by hand, as a separate decision.
results/

# Stages a results deposit out of results/ and configs/. A local packaging
# step, kept here so the next deposit is one command, and out of git because
# it is no part of what a run needs.
tools/make_deposit.py

# What tools/pseudonymize_ids.py writes. The mapping is the key back to the
# real IDs, and neither belongs in git; this is a safeguard for a run whose
# dest_dir falls inside the repository.
private_animal_id.csv
*_pseudonymized*

# Editable/build artefacts
*.egg-info/
build/
dist/
.coverage
